# Copy to .env and fill in. Blank values fall back to defaults.

LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Discord
# ---------------------------------------------------------------------------
# Bot token and application ID from https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
# Optional: register commands to one guild for instant updates (recommended in dev).
DISCORD_GUILD_ID=

# ---------------------------------------------------------------------------
# Argus API
# ---------------------------------------------------------------------------
# "http" for the real API, "mock" to run entirely off the local database.
ARGUS_CLIENT=mock
# Required when ARGUS_CLIENT=http. The platform serves the bot API under /api/bot/v1
# (docs/argus-backend-contract.md). The token must equal the platform's DISCORD_BOT_API_TOKEN.
ARGUS_API_BASE_URL=https://arkhonindustries.com/api/bot
ARGUS_API_TOKEN=
# Optional separate status endpoint. Accepts the full status JSON or the
# platform's existing public health probe, e.g. https://arkhonindustries.com/api/health
ARGUS_STATUS_URL=
# Base URL for "open in Argus" links.
ARGUS_APP_URL=https://arkhonindustries.com/app

# SQLite file for links, alert preferences, tickets, and (in mock mode) mock Argus data.
ARGUS_DB_PATH=./data/argus.sqlite
# IANA time zone for "today" in dates and daily maintenance.
ARGUS_TIMEZONE=America/Denver

# ---------------------------------------------------------------------------
# Event webhook (POST /webhooks/argus)
# ---------------------------------------------------------------------------
# Shared HMAC-SHA256 secret (16+ characters); equals the platform's DISCORD_BOT_WEBHOOK_SECRET.
# Leave blank to turn the webhook server off.
# Generate one with: openssl rand -hex 32
ARGUS_WEBHOOK_SECRET=
ARGUS_WEBHOOK_HOST=0.0.0.0
ARGUS_WEBHOOK_PORT=8080
# Channel for broadcast events (events with no userId), as event.type=channelId pairs.
# Personal events are only ever DMed to their linked owner.
# Example: mission.posted=123456789012345678
ARGUS_EVENT_ROUTES=

# ---------------------------------------------------------------------------
# Service status (#argus-status)
# ---------------------------------------------------------------------------
# Channel for status change posts. Leave blank to only log changes.
ARGUS_STATUS_CHANNEL_ID=
# Role pinged only when Argus becomes degraded or has an outage.
ARGUS_STATUS_ROLE_ID=
# Seconds between status polls (0 = rely on service.status_changed webhooks only).
ARGUS_STATUS_POLL_SECONDS=60
# Consecutive polls that must agree before a change is announced.
ARGUS_STATUS_CONFIRMATIONS=2

# ---------------------------------------------------------------------------
# Support (/argus help)
# ---------------------------------------------------------------------------
# Set both to enable the "Open an Argus ticket" button (shared ticket flow).
ARGUS_SUPPORT_CHANNEL_ID=
ARGUS_STAFF_ROLE_ID=
# "thread" (private threads in the support channel) or "channel" (private channels).
ARGUS_TICKET_MODE=thread
# Category for private ticket channels (channel mode, or when threads are unavailable).
ARGUS_TICKET_CATEGORY_ID=
# Where a summary is posted when a ticket closes.
ARGUS_TICKET_ARCHIVE_CHANNEL_ID=
# Shown instead of the ticket button when tickets are not configured.
ARGUS_SUPPORT_URL=https://arkhonindustries.com/contact
# FAQ JSON file (default: bots/argus/faq.json).
ARGUS_FAQ_PATH=

# ---------------------------------------------------------------------------
# Certa
# ---------------------------------------------------------------------------
# Path to the Certa bot's SQLite file (read-only). When set, /argus link tells
# users who are also linked to Certa.
CERTA_DB_PATH=
