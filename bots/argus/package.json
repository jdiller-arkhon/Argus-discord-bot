{
  "name": "@arkhon/argus-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/index.js",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "register": "tsx --env-file-if-exists=../../.env src/register.ts",
    "register:prod": "node dist/register.js",
    "dev-tool": "tsx --env-file-if-exists=../../.env src/tools/dev.ts"
  },
  "dependencies": {
    "@arkhon/shared": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.27.0",
    "luxon": "^3.7.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/luxon": "^3.7.6",
    "tsx": "^4.23.15"
  }
}
